      "name": "Set Content Details",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nreturn items.map(item => {\n  const response = item.json;\n\n  const generatedContent =\n    response.candidates?.[0]?.content?.parts\n      ?.map(part => part.text || \"\")\n      .join(\"\\n\")\n      .trim();\n\n  if (!generatedContent) {\n    throw new Error(\"Gemini generated content not found. Check API response.\");\n  }\n\n  return {\n    json: {\n      ...response,\n      generatedContent: generatedContent\n    }\n  };\n});"
      },
      "id": "18532e4a-aca7-4a3e-b417-c4919a104941",
      "name": "Format Generated Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": ""
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"contents\": [\n    {\n      \"parts\": [\n        {\n          \"text\": \"Create a professional social media post with hashtags. Topic: {{$json.topic}}. Platform: {{$json.platform}}. Tone: {{$json.tone}}. Language: {{$json.language}}. Content type: {{$json.content_type}}\"\n        }\n      ]\n    }\n  ]\n}",
        "options": {}
      },
